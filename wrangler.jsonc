{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchtower", "main": "worker/index.ts", "compatibility_date": "2026-11-01", "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "watchtower", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_URL": "http://localhost:5173", "MAX_WORKSPACE_MONITORS": "5", "MAX_GLOBAL_MONITORS": "10", "CHECK_BATCH_SIZE": "2", "APPROVED_MONITOR_HOSTS": "", "ENVIRONMENT": "development" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
